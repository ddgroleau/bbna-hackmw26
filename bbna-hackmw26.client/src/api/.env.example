# Copy to .env in this folder. .env is gitignored; never commit real keys.

# Required. Bedrock API key from https://console.aws.amazon.com/bedrock/
AWS_BEARER_TOKEN_BEDROCK=

# Optional. Bedrock model for the specialists that gather evidence (meteorologist, workforce analyst).
# Defaults to amazon.nova-lite-v1:0.
# BEDROCK_MODEL_ID=

# Optional. Bedrock model for the roles that judge the evidence or talk with the manager
# (rules analyst, decision lead, conversation agent). Defaults to amazon.nova-pro-v1:0.
# BEDROCK_JUDGMENT_MODEL_ID=

# Optional. Where the ASP.NET server (weather endpoints) listens. Defaults to https://localhost:7008.
# WEATHER_SERVER_URL=
