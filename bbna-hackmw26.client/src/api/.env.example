# Copy to .env in this folder. .env is gitignored; never commit real keys.

# Required. Bedrock API key from https://console.aws.amazon.com/bedrock/
AWS_BEARER_TOKEN_BEDROCK=

# Optional. Bedrock model used by /api/analyze. Defaults to amazon.nova-lite-v1:0.
# BEDROCK_MODEL_ID=

# Optional. Where the ASP.NET server (weather endpoints) listens. Defaults to https://localhost:7008.
# WEATHER_SERVER_URL=
