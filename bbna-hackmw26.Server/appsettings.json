{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Building": {
    "Code": "KC",
    "Name": "USDA Economic Research Service - Kansas City Facility",
    "Address": "805 Pennsylvania Avenue, Kansas City, MO 64105",
    "Latitude": 39.1045,
    "Longitude": -94.5909
  },
  "Nws": {
    "BaseUrl": "https://api.weather.gov/",
    // TODO: add contact info, e.g. "bbna-hackmw26/1.0 (team@example.com)". NWS asks for it and may block anonymous agents.
    "UserAgent": "bbna-hackmw26/1.0",
    // Minutes to reuse a weather reading before calling NWS again.
    "CacheMinutes": 5,
    // Minutes to reuse the active alerts list. Kept short because warnings are time-critical.
    "AlertsCacheMinutes": 1,
    // Minutes to reuse the multi-day forecast. NWS updates it roughly hourly.
    "ForecastCacheMinutes": 15
  },
  // NOAA Storm Prediction Center severe storm outlooks (Day 1-3), used by /api/weather/storm-outlook.
  "Spc": {
    "BaseUrl": "https://www.spc.noaa.gov/products/outlook/",
    "UserAgent": "bbna-hackmw26/1.0",
    // Minutes to reuse the outlooks. SPC updates them a few times a day.
    "CacheMinutes": 15
  },
  // The building's working day, used to split /api/weather/forecast into time windows (local building time).
  // Overnight = EveningCommuteEnd (day before) -> MorningCommuteStart.
  "Workday": {
    "TimeZone": "America/Chicago",
    "MorningCommuteStart": "06:00",
    "WorkStart": "09:00",
    "WorkEnd": "16:00",
    "EveningCommuteEnd": "18:00"
  },
  "Audit": {
    "DatabasePath": "data/audit.db"
  }
}
