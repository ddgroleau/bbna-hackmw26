# TODO: port 5299 does not match launchSettings.json (http://localhost:5155); update before sending requests.
@bbna_hackmw26.Server_HostAddress = http://localhost:5299

GET {{bbna_hackmw26.Server_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{bbna_hackmw26.Server_HostAddress}}/api/weather/raw
Accept: application/json

###

GET {{bbna_hackmw26.Server_HostAddress}}/api/weather/current
GET {{bbna_hackmw26.Server_HostAddress}}/api/situation?scenario=winter-storm
Accept: application/json

###

GET {{bbna_hackmw26.Server_HostAddress}}/api/weather/alerts
Accept: application/json

###

# Only Extreme/Severe alerts (e.g. tornado and severe thunderstorm warnings)
GET {{bbna_hackmw26.Server_HostAddress}}/api/weather/alerts?severeOnly=true
Accept: application/json

###
